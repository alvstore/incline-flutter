<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>INCLINE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>INCLINE</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Incline uses Face ID for seamless member sign-in and authorizing club privileges.</string>
	<key>NSCameraUsageDescription</key>
	<string>Incline uses the camera for member profile photos and InBody scan diagnostics.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Incline accesses your photo library to set your member avatar.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Incline reads your step count, active calories, resting heart rate, and workouts to personalize your training plan.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Incline writes completed club workout sessions to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Incline uses your location to verify club arrival for automated turnstile gate pass access and contrast suite proximity check-ins.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Incline uses Bluetooth to communicate with club turnstile beacons and smart recovery equipment.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Incline uses Bluetooth to communicate with club turnstile beacons and smart recovery equipment.</string>
	<key>NSMotionUsageDescription</key>
	<string>Incline reads step counting and motion telemetry during your club training sessions.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.incline.inclineApp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>incline</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
